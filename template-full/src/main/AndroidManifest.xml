<?xml version="1.0" encoding="utf-8"?>
<!-- M6 模板壳 full 变体：全量桥权限（十能力 dangerous 权限集中申报 +
     截屏投影前台服务）。package/versionCode/versionName/label 由导出管线
     AxmlPatcher 按项目改写；组件一律绝对类名（改包名不影响解析）。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:glEsVersion="0x00030001" android:required="false" />

    <!-- zq 桥能力集中申报（与织雀本体同表，规格 §4.6：App 集中持权，网页按需申请） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 截屏（MediaProjection）前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:label="织雀壳"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name="com.zhique.template.shell.TemplateShellFull"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.zhique.template.shell.TemplateScreenService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
