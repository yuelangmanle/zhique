<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 只读分享路径：项目沙盒目录（zq.share.file 用，规格 §4.6） -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="projects" path="zhique-root/projects/" />
    <!-- M6 导出物分享（apk / .jks 备份） -->
    <cache-path name="exports" path="exports/" />
    <!-- M8 Apilot 导入大负载的一次性只读 URI（即用即弃，Apilot 侧 10 分钟后亦清理） -->
    <cache-path name="apilot" path="apilot/" />
</paths>
