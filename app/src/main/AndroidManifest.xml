<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 包可见性（Android 11+ package visibility）：Apilot 桥接需要能探测到
         com.example.api_manager 是否安装并发起 PICK/IMPORT Intent——
         真机 B6：缺 <queries> 时 checkInstalled 永远 false，双向流转全灰。 -->
    <queries>
        <package android:name="com.example.api_manager" />
        <intent>
            <action android:name="com.apilot.intent.action.PICK_API_CONFIG" />
        </intent>
        <intent>
            <action android:name="com.apilot.intent.action.IMPORT_API_CONFIGS" />
        </intent>
    </queries>

    <!-- M5 权限桥：全部 dangerous 权限集中申报（App 集中持权，网页按需经授权卡申请，规格 §4.6） -->
    <!-- 硬件可选声明（TV/桌面/ChromeOS 兼容：无相机/定位/话筒设备也能安装运行） -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 截屏（MediaProjection）前台服务（审查修复 #3：API34+ 硬性要求） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- M6 导出：PackageInstaller 会话安装导出应用（「未知来源」授权一次，规格 §4.7 交付） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />


    <!-- allowBackup=false（质量审查 Important-3）：应用锁盐+哈希、密钥密文不随
     云备份/设备迁移导出——防离线爆破与密文搬运 -->
    <!-- 网络安全配置：用户自填 HTTP 端点（Apilot 环回网关 / LAN 推理服务）必须允许明文 -->
    <application android:label="织雀" android:name=".ZhiqueApplication" android:allowBackup="false" android:networkSecurityConfig="@xml/network_security_config" android:theme="@style/Theme.Zhique">

        <!-- zq.share.file 的只读 URI 授权 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.zqfile"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/zq_share_paths" />
        </provider>

        <!-- 截屏期间的前台服务：mediaProjection 类型（API34+ 必需） -->
        <service
            android:name=".screen.ZqScreenService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- M6 导出安装会话的回执（PackageInstaller 经 IntentSender 回调） -->
        <receiver
            android:name=".export.ExportDelivery$InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zhique.runner.action.INSTALL_COMMIT" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 系统分享目标：其他 App 分享文本 → 直达智能粘贴预览（规格 §2.1 F1） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
